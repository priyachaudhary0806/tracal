# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.cert
*.pfx

# debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env & secret files (never commit secrets)
.env
.env*
*.env
*.env.*
!.env.example
!backend/.env.example

# user uploads & private documents (verification docs, IDs)
/uploads/
uploads/
backend/uploads/

# database dumps & backups
*.dump
*.sql
*.tar
*.bak
*.rdb

# python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
env/
backend/venv/

# scratch & temporary test scripts
/scratch/
scratch/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
