# ─── Tracal Backend Environment Template ──────────────────────────────────────
# Copy this file to backend/.env and replace placeholders with your actual keys.
# NEVER commit backend/.env containing real secret keys to source control.
# ─────────────────────────────────────────────────────────────────────────────

# JWT Secret Key (generate a secure 32+ character string for production)
JWT_SECRET_KEY=your_jwt_secret_key_here

# MongoDB Connection String (backend database only)
MONGODB_URI=mongodb://localhost:27017

# Admin Seed Credentials (for upcoming secure admin account initialization)
ADMIN_EMAIL=admin@tracal.com
ADMIN_PASSWORD=your_secure_admin_password_here

# CORS / Allowed Origins (comma-separated origins; empty allows all in dev)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── External AI & Places Services ──────────────────────────────────────────────
# Google Gemini API Key (Required for: AI Travel Personality, AI Review Intelligence, Reality Check)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Gemini model override (defaults to gemini-3.5-flash with gemini-3.5-flash-lite fallback)
GEMINI_MODEL=gemini-3.5-flash

# Local Explorer: Powered by OpenStreetMap (Nominatim & Overpass API).
# No API key or billing required!
# (Legacy Google Places API key is deprecated and no longer needed)
# GOOGLE_PLACES_API_KEY=not_required

# ─── Payment Gateway (Razorpay) ───────────────────────────────────────────────
# Razorpay Key ID and Secret (Required for: Booking payments)
# Obtain test/live keys from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ─── Email (SMTP) Configuration ───────────────────────────────────────────────
# Gmail SMTP settings (Required for: System email notifications, alerts)
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
FROM_EMAIL=your_email@gmail.com
