# ─── Tracal Frontend Environment Template ────────────────────────────────────
# Copy this file to .env.local for Next.js frontend configuration.
# ─────────────────────────────────────────────────────────────────────────────

# Client-accessible backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side backend API URL (for Next.js SSR / server actions)
API_URL=http://127.0.0.1:8000
